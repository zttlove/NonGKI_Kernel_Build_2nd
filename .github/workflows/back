# ============================================================
      # 关键：修复必须放在 patch-susfs 之后、其他 patch 之前
      # 工作目录是 device_kernel，不是 kernel
      # ============================================================
      - name: Fix namei.c missing found_sus_path and retry label
        working-directory: device_kernel
        shell: bash
        run: |
          set -euo pipefail
          N="fs/namei.c"
          [[ -f "$N" ]] || { echo "::error::找不到 $N"; exit 1; }

          echo "=== 修复前 __lookup_hash 附近 ==="
          sed -n '1650,1680p' "$N"

          # ---------- 1. 定位报错行 1659 所在函数：__lookup_hash ----------
          # __lookup_hash 的函数结束在 return dentry; 后跟 }
          # 我们要在这个函数内插入声明和 retry: 标签

          # 找到 __lookup_hash 函数起始行
          FUNC_START=$(grep -n "^static struct dentry \*__lookup_hash(" "$N" | head -1 | cut -d: -f1)
          [[ -n "$FUNC_START" ]] || { echo "::error::找不到 __lookup_hash 函数"; exit 1; }
          echo "__lookup_hash 起始行: $FUNC_START"

          # 找到该函数里 goto retry; 的行（一定在 1659 之后、函数结束前）
          GOTO_LINE=$(awk -v s="$FUNC_START" 'NR>s && /goto retry;/ { print NR; exit }' "$N")
          [[ -n "$GOTO_LINE" ]] || { echo "::error::__lookup_hash 里没有 goto retry;"; exit 1; }
          echo "__lookup_hash 里 goto retry; 行: $GOTO_LINE"

          # 找到该函数里 "dentry = d_alloc(base, name);" 的行，作为 retry 标签位置
          ALLOC_LINE=$(awk -v s="$FUNC_START" -v g="$GOTO_LINE" 'NR>s && NR<g && /dentry = d_alloc\(base, name\);/ { print NR; exit }' "$N")
          echo "d_alloc 行: ${ALLOC_LINE:-未找到}"

          # ---------- 2. 检查 __lookup_hash 里是否已经有 found_sus_path 声明 ----------
          # 只看 FUNC_START 到 GOTO_LINE 之间
          if awk -v s="$FUNC_START" -v g="$GOTO_LINE" 'NR>s && NR<g && /bool found_sus_path = false;/ {found=1} END{exit !found}' "$N"; then
            echo "✅ __lookup_hash 里已有 found_sus_path 声明"
          else
            # 在 __lookup_hash 函数体第一行（含 { 的那行之后）插入
            # 简单做法：在函数里第一个 struct dentry *dentry; 之后插入
            INSERT_AFTER=$(awk -v s="$FUNC_START" 'NR>s && /struct dentry \*dentry/ { print NR; exit }' "$N")
            [[ -n "$INSERT_AFTER" ]] || INSERT_AFTER="$FUNC_START"
            awk -v ins="$INSERT_AFTER" '
              NR==ins { print; print "\tbool found_sus_path = false;"; next }
              { print }
            ' "$N" > "$N.tmp" && mv "$N.tmp" "$N"
            echo "✅ 已在 __lookup_hash 内插入 found_sus_path 声明（第 $INSERT_AFTER 行之后）"
            # 行号变了，重新算 GOTO_LINE
            FUNC_START=$(grep -n "^static struct dentry \*__lookup_hash(" "$N" | head -1 | cut -d: -f1)
            GOTO_LINE=$(awk -v s="$FUNC_START" 'NR>s && /goto retry;/ { print NR; exit }' "$N")
          fi

          # ---------- 3. 检查 __lookup_hash 里是否已有 retry: 标签 ----------
          if awk -v s="$FUNC_START" -v g="$GOTO_LINE" 'NR>s && NR<g && /^retry:/ {found=1} END{exit !found}' "$N"; then
            echo "✅ __lookup_hash 里已有 retry: 标签"
          else
            ALLOC_LINE=$(awk -v s="$FUNC_START" -v g="$GOTO_LINE" 'NR>s && NR<g && /dentry = d_alloc\(base, name\);/ { print NR; exit }' "$N")
            [[ -n "$ALLOC_LINE" ]] || { echo "::error::__lookup_hash 里找不到 d_alloc(base, name);"; exit 1; }
            awk -v ins="$ALLOC_LINE" '
              NR==ins { print "retry:"; print; next }
              { print }
            ' "$N" > "$N.tmp" && mv "$N.tmp" "$N"
            echo "✅ 已在 __lookup_hash 内 d_alloc 前插入 retry: 标签（第 $ALLOC_LINE 行前）"
          fi

          # ---------- 4. 校验 ----------
          echo "=== 修复后 __lookup_hash 附近 ==="
          sed -n '1650,1690p' "$N"
          echo "=== git diff ==="
          git diff -- "$N" || true

          ccache -C 2>/dev/null || true
          echo "✅ Fix step 完成"
